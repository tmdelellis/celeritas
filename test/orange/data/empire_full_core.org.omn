!------------------------------------------------------------------------------
[UNIVERSE=general drum_in_north_assembly]
interior hex

[UNIVERSE][SHAPE=prism hex]
num_sides 6
apothem 16.75
rotfrac 0.5
extents 0 60

[UNIVERSE][SHAPE=cyl inner_cyl]
axis z
radius 13.8
extents 0 60

[UNIVERSE][SHAPE=cyl outer_cyl]
axis z
radius 14.8
extents 0 60

[UNIVERSE][SHAPE=cuboid clip]
faces -7.5 7.5 -7.5 7.5 0 60
origin 0.0 -10.6066 0
rotate 0.7071067811865475 0.7071067811865475 0 -0.7071067811865475 0.7071067811865475 0 0 0 1

[UNIVERSE][CELL fill1]
comp 2
shapes -hex +outer_cyl

[UNIVERSE][CELL fill2]
comp 1
shapes -outer_cyl +inner_cyl -clip

[UNIVERSE][CELL fill3]
comp 2
shapes -outer_cyl +inner_cyl +clip

[UNIVERSE][CELL fill4]
comp 2
shapes -inner_cyl

