!------------------------------------------------------------------------------
[UNIVERSE=general fuel_assembly]
interior fuel_assembly_outer

[UNIVERSE][SHAPE=prism fuel_assembly_outer]
num_sides 6
apothem 16.75
rotfrac 0.5
extents 0 60

[UNIVERSE][SHAPE=prism fuel_assembly_fill]
num_sides 6
apothem 16.13694002385004
rotfrac 0.5 
extents 0 60

[UNIVERSE][ARRAY fuel_assembly]
fill      loading
interior  fuel_assembly_fill
place     9 9 0
origin    0 0 0

[UNIVERSE][CELL fuel_assembly_gap]
comp 3
shapes -fuel_assembly_outer +fuel_assembly_fill

!------------------------------------------------------------------------------
[UNIVERSE=general heat_pipe_bottom_assembly]
interior heat_pipe_bottom_outer

