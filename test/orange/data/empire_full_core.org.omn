[UNIVERSE=general global]
interior "outer"

[UNIVERSE][SHAPE=cuboid outer]
faces -117 117 -117 117 -20 70

[UNIVERSE][SHAPE=cyl core_bound]
axis z
radius 117
extents 0 60
origin 0 0 0

[UNIVERSE][ARRAY core_fill]
fill      core
place     4 5 0
origin    0 0 0
interior core_bound

[UNIVERSE][SHAPE=cyl bottom_refl_bound]
