!##############################################################################
[GEOMETRY]
global "global"

!##############################################################################
! PINS
!##############################################################################

!------------------------------------------------------------------------------
[UNIVERSE=general f]
interior fhex
[UNIVERSE][SHAPE=prism fhex]
num_sides 6
apothem 1.075
extents 0 60

[UNIVERSE][SHAPE=cyl inner_cyl]
axis z
radius 0.925
extents 0 60

[UNIVERSE][SHAPE=cyl outer_cyl]
axis z
radius 0.975
extents 0 60

[UNIVERSE][CELL ffill1]
comp 3
shapes -fhex +outer_cyl

[UNIVERSE][CELL ffill2]
comp 0
shapes -outer_cyl +inner_cyl

[UNIVERSE][CELL ffill3]
comp 6
shapes -inner_cyl

!------------------------------------------------------------------------------
[UNIVERSE=general m]
interior mhex
[UNIVERSE][SHAPE=prism mhex]
num_sides 6
apothem 1.075
extents 0 60
[UNIVERSE][CELL mfill]
comp 3
shapes -mhex

!------------------------------------------------------------------------------
[UNIVERSE=general be_b]
interior mhex
[UNIVERSE][SHAPE=prism mhex]
num_sides 6
apothem 1.075
extents 0 20
[UNIVERSE][CELL mfill]
comp 2
shapes -mhex

!------------------------------------------------------------------------------
[UNIVERSE=general be_t]
interior mhex
[UNIVERSE][SHAPE=prism mhex]
num_sides 6
apothem 1.075
extents 0 10
[UNIVERSE][CELL mfill]
comp 2
shapes -mhex

!------------------------------------------------------------------------------
[UNIVERSE=general y]
interior yhex

[UNIVERSE][SHAPE=prism yhex]
num_sides 6
apothem 1.075
extents 0 60

[UNIVERSE][SHAPE=cyl inner_cyl]
axis z
radius 0.95
extents 0 60

[UNIVERSE][SHAPE=cyl outer_cyl]
axis z
radius 1
extents 0 60

[UNIVERSE][CELL yfill1]
comp 3
shapes -yhex +outer_cyl

[UNIVERSE][CELL yfill2]
comp 0
shapes -outer_cyl +inner_cyl

[UNIVERSE][CELL yfill3]
comp 4
shapes  -inner_cyl

!------------------------------------------------------------------------------
[UNIVERSE=general h]
interior hhex

[UNIVERSE][SHAPE=prism hhex]
num_sides 6
apothem 1.075
extents 0 60

[UNIVERSE][SHAPE=cyl cyl]
axis z
radius 1
extents 0 60

[UNIVERSE][CELL hfill1]
comp 3
shapes -hhex +cyl

[UNIVERSE][CELL yfill2]
comp 5
shapes -cyl 

!------------------------------------------------------------------------------
[UNIVERSE=general h_b]
interior hhex

[UNIVERSE][SHAPE=prism hhex]
num_sides 6
apothem 1.075
extents 0 20

[UNIVERSE][SHAPE=cyl cyl]
axis z
radius 1
extents 0 20

[UNIVERSE][CELL hfill1]
comp 2
shapes -hhex +cyl

[UNIVERSE][CELL yfill2]
comp 5
shapes -cyl 

!------------------------------------------------------------------------------
[UNIVERSE=general h_t]
interior hhex

[UNIVERSE][SHAPE=prism hhex]
num_sides 6
apothem 1.075
extents 0 10

[UNIVERSE][SHAPE=cyl cyl]
axis z
radius 1
extents 0 10

[UNIVERSE][CELL hfill1]
comp 2
shapes -hhex +cyl

[UNIVERSE][CELL yfill2]
comp 5
shapes -cyl 



